rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function admin() { return signedIn() && request.auth.token.email == 'luissarmiento@gmail.com' && request.auth.token.email_verified == true; }
    function owner(email) { return signedIn() && request.auth.token.email == email; }
    function validProduct() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name','brand','price','imageUrl','createdAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
        d.brand is string && d.brand.size() > 0 && d.brand.size() <= 50 &&
        d.price is number && d.price > 0 && d.imageUrl is string && d.imageUrl.size() <= 900000;
    }
    match /gorras/{id} {
      allow read: if signedIn();
      allow create, update: if admin() && validProduct();
      allow delete: if admin();
    }
    match /pedidos/{id} {
      allow read: if admin() || owner(resource.data.userEmail);
      allow create: if !admin() && owner(request.resource.data.userEmail) &&
        request.resource.data.keys().hasOnly(['userEmail','items','total','date','status']) &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 &&
        request.resource.data.total is number && request.resource.data.total > 0 &&
        request.resource.data.date is timestamp && request.resource.data.status == 'pendiente';
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) && request.resource.data.status in ['pendiente','preparando','enviado','aduana','reparto','entregado'] && request.resource.data.updatedAt == request.time;
    }
    match /tokens/{token} {
      allow read, delete: if signedIn() && (resource.data.get('uid','') == request.auth.uid || owner(resource.data.email));
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && owner(request.resource.data.email) && request.resource.data.isAdmin == admin();
      allow update: if signedIn() && (resource.data.get('uid','') == request.auth.uid || owner(resource.data.email)) && request.resource.data.uid == request.auth.uid && owner(request.resource.data.email) && request.resource.data.isAdmin == admin();
    }
  }
}
